


@page
@model StudentRegistrationApp.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Registered Students";
}

<h1>Registered Students</h1>

<p>
    <a asp-page="Create" class="btn btn-success">Register New Student</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Enrollment Year</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.StudentList) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.FullName)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>@Html.DisplayFor(modelItem => item.Department)</td>
            <td>@Html.DisplayFor(modelItem => item.EnrollmentYear)</td>
            <td>
                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>